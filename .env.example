# Copy to .env and adjust. .env is git-ignored.
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
POSTGRES_PORT=5432
APP_PORT=8080

# Only user-service stores the signing key, in the user-signing-keys Docker volume.
JWT_TTL=PT15M
SERVICE_JWT_TTL=PT5M
# Use a different random value for every client: openssl rand -hex 32
MONITOR_SERVICE_CLIENT_SECRET=local-dev-monitor-client-secret-replace-before-deployment
CHECK_SERVICE_CLIENT_SECRET=local-dev-check-client-secret-replace-before-deployment
NOTIFICATION_SERVICE_CLIENT_SECRET=local-dev-notification-client-secret-replace-before-deployment
# The first upgrade imports existing hashed users from monitor-service. Afterwards this can be empty.
# USER_MIGRATION_SOURCE_URL=
# Used only to create the first supervisor; no public registration endpoint exists.
SUPERVISOR_EMAIL=supervisor@example.com
SUPERVISOR_PASSWORD=change-me-before-deployment

# Real notification delivery. Keep disabled until at least one transport is configured.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_INTERVAL_MS=5000
NOTIFICATION_DELIVERY_BATCH_SIZE=20
NOTIFICATION_DELIVERY_CONCURRENCY=4
NOTIFICATION_DELIVERY_LEASE=PT2M
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_RETRY_DELAY=PT30S

# SMTP. For a local smoke test use Mailpit on port 1025; production providers usually use 587.
EMAIL_ENABLED=false
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=monitoring@localhost
MAIL_SMTP_AUTH=false
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false

# Telegram Bot API. The proxy is applied only to Telegram requests.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_PROXY_HOST=host.docker.internal
TELEGRAM_PROXY_PORT=3128
TELEGRAM_REQUEST_TIMEOUT=PT15S
