# Copy to .env and adjust. .env is git-ignored.
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
POSTGRES_PORT=5432
APP_PORT=8080

# Parameterized application logs and optional Sentry error reporting.
APP_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Only user-service stores the signing key, in the user-signing-keys Docker volume.
JWT_TTL=PT15M
SERVICE_JWT_TTL=PT5M
# Use a different random value for every client: openssl rand -hex 32
MONITOR_SERVICE_CLIENT_SECRET=local-dev-monitor-client-secret-replace-before-deployment
CHECK_SERVICE_CLIENT_SECRET=local-dev-check-client-secret-replace-before-deployment
NOTIFICATION_SERVICE_CLIENT_SECRET=local-dev-notification-client-secret-replace-before-deployment
REPORT_SERVICE_CLIENT_SECRET=local-dev-report-client-secret-replace-before-deployment
# Used only to create the first supervisor; no public registration endpoint exists.
SUPERVISOR_EMAIL=supervisor@example.com
SUPERVISOR_PASSWORD=change-me-before-deployment

# Report files in MinIO. The root account is used only by minio-init to create the private
# bucket and the report-service account; report-service gets only MINIO_ACCESS_KEY/SECRET_KEY.
MINIO_ROOT_USER=local-dev-minio-root
MINIO_ROOT_PASSWORD=local-dev-minio-root-password-replace-before-deployment
MINIO_BUCKET=reports
MINIO_ACCESS_KEY=report-service
MINIO_SECRET_KEY=local-dev-report-storage-secret-replace-before-deployment
# MB means 2^20 bytes. The request limit leaves room for multipart boundaries and headers;
# the gateway and report-service both apply it.
REPORT_MAX_FILE_SIZE=10MB
REPORT_MAX_REQUEST_SIZE=12MB
# Generated reports. Limits a request can break are refused with 400; those a worker meets
# end the job as FAILED with LIMIT_EXCEEDED, never with a cut report.
REPORT_GENERATION_MAX_PERIOD_DAYS=31
REPORT_GENERATION_MAX_MONITORS=100
REPORT_GENERATION_MAX_SOURCE_ROWS=100000
REPORT_GENERATION_TIMEOUT=PT5M
REPORT_GENERATION_CONCURRENCY=2
REPORT_GENERATION_MAX_ATTEMPTS=3
REPORT_GENERATION_RETRY_DELAY=PT30S
REPORT_GENERATION_LEASE_DURATION=PT1M
REPORT_IDEMPOTENCY_TOMBSTONE_TTL=PT24H

# Settings on top of the base files: empty or dev or prod, see README.
SPRING_PROFILES_ACTIVE=default

# HTTP is the default. Set any flow to kafka and start the Kafka Compose overlay.
# Every producer and consumer receives the same values from docker-compose.yml.
CHECK_RESULTS_TRANSPORT=http
INCIDENT_EVENTS_TRANSPORT=http
RESOURCE_EVENTS_TRANSPORT=http
REPORT_EVENTS_TRANSPORT=http
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# Real notification delivery. Keep disabled until at least one transport is configured.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_INTERVAL_MS=5000
NOTIFICATION_DELIVERY_BATCH_SIZE=20
NOTIFICATION_DELIVERY_CONCURRENCY=4
NOTIFICATION_DELIVERY_LEASE=PT2M
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_RETRY_DELAY=PT30S

# SMTP. For a local smoke test use Mailpit on port 1025; production providers usually use 587.
EMAIL_ENABLED=false
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=monitoring@localhost
MAIL_SMTP_AUTH=false
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false

# Telegram Bot API. The proxy is applied only to Telegram requests.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_PROXY_HOST=host.docker.internal
TELEGRAM_PROXY_PORT=3128
TELEGRAM_REQUEST_TIMEOUT=PT15S
